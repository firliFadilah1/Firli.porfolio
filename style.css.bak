/* style.css - Desain lebih profesional untuk portfolio Firli */

:root{
  --bg:#0f1724; /* dark background */
  --card:#0b1220;
  --muted:#9aa4b2;
  --accent:#5eead4; /* teal */
  --accent-2:#7c5cff; /* purple */
  --glass: rgba(255,255,255,0.04);
  --container:1100px;
  --radius:14px;
}

*{box-sizing:border-box}
html,body{height:100%}
/* Menggunakan font Poppins dari Google Fonts (lihat index.html & about.html) */
body{font-family:'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, Arial; margin:0; color:#e6eef8; background:linear-gradient(180deg,#071022 0%, #0f1724 60%); -webkit-font-smoothing:antialiased}
.container{max-width:var(--container); margin:0 auto; padding:1.25rem}

/* Heading style agar font terlihat menarik */
h1,h2,h3,h4{font-family:'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, Arial; letter-spacing: -0.2px; margin:0}

/* Header */
.site-header{backdrop-filter:blur(6px); position:sticky; top:0; z-index:40}
.header-inner{display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:0.6rem 0}
.logo{font-weight:800; font-size:1.25rem; color:var(--accent-2); text-decoration:none}
.nav{display:flex; gap:0.5rem; align-items:center}
.nav-link{color:var(--muted); text-decoration:none; padding:0.5rem 0.75rem; border-radius:10px}
.nav-link.active, .nav-link:hover{color:#fff; background:rgba(255,255,255,0.03)}
.btn{display:inline-block; background:linear-gradient(90deg,var(--accent),var(--accent-2)); color:#021024; padding:0.6rem 1rem; border-radius:10px; text-decoration:none; font-weight:600}
.btn-sm{padding:0.4rem 0.6rem; font-size:0.9rem}
.btn-outline{background:transparent; color:var(--accent); border:1px solid rgba(255,255,255,0.06)}
.nav-toggle{display:none; background:transparent; border:0; color:var(--muted); font-size:1.2rem}

/* HERO */
.hero{padding:3rem 0}
.hero-grid{display:grid; grid-template-columns:1fr 360px; gap:2rem; align-items:center}
.eyebrow{color:var(--accent); margin:0; font-weight:600}
.hero-content h1{font-size:2.25rem; margin:0 0 .5rem}
.lead{color:var(--muted); line-height:1.6}
.hero-ctas{display:flex; gap:0.75rem; margin-top:1rem}
.skills{display:flex; gap:0.5rem; list-style:none; padding:0; margin-top:1rem; color:var(--muted)}
.skills li{background:var(--glass); padding:.35rem .6rem; border-radius:10px; font-size:0.85rem}

/* Hero card */
.hero-card{background:linear-gradient(180deg, rgba(255,255,255,0.03), transparent); border-radius:var(--radius); padding:1rem; box-shadow:0 6px 30px rgba(2,6,23,0.6); overflow:hidden}
.card-media img{width:100%; border-radius:10px; display:block; padding: 12px; }
.card-body{padding-top:0.75rem}
.card-body h4{margin:0}
.muted{color:var(--muted)}
.card-stats{display:flex; gap:1rem; margin-top:0.75rem}
.card-stats div{background:rgba(255,255,255,0.03); padding:.5rem .75rem; border-radius:10px; text-align:center}
.card-stats strong{display:block; color:#fff}

/* Services */
.services{padding:2.25rem 0}
.section-head{margin-bottom:1rem}
.services-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1rem}
.service{background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent); padding:1rem; border-radius:12px; text-align:center}
.service img{width:48px; height:48px; margin-bottom:0.5rem}
.service h3{margin:0.5rem 0}

/* Portfolio */
.portfolio{padding:2.25rem 0}
.portfolio-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1rem}
.portfolio-item{position:relative; border-radius:12px; overflow:hidden; cursor:pointer}
.portfolio-item img{width:100%; height:500px; object-fit:cover; display:block; transition:transform .45s ease}
.portfolio-item .overlay{position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; padding:1rem; background:linear-gradient(180deg, transparent 30%, rgba(2,4,12,0.6)); transform:translateY(100%); transition:transform .35s ease}
.portfolio-item:hover img{transform:scale(1.05)}
.portfolio-item:hover .overlay{transform:translateY(0)}
.overlay h4{margin:0}

/* Contact */
.contact{padding:2.25rem 0}
.contact-grid{display:grid; grid-template-columns:360px 1fr; gap:1rem}
.contact-card{background:linear-gradient(180deg, rgba(255,255,255,0.03), transparent); padding:1rem; border-radius:12px}
.contact-list{list-style:none; padding:0; margin:0.75rem 0}
.contact-list li{margin-bottom:0.5rem}
.contact-form{display:grid; gap:0.6rem}
.contact-form input, .contact-form textarea{padding:0.75rem; border-radius:10px; border:0; background:rgba(255,255,255,0.02); color:#e6eef8}
.btn-block{width:100%}

/* Modal */
.modal{position:fixed; inset:0; display:none; align-items:center; justify-content:center; background:rgba(2,6,23,0.6); z-index:60}
.modal[aria-hidden="false"]{display:flex}
.modal-content{background:linear-gradient(180deg,#071022,#071624); padding:1rem; border-radius:12px; max-width:900px; width:90%; box-shadow:0 20px 60px rgba(2,6,23,0.8)}
.modal-close{background:transparent; border:0; color:var(--muted); font-size:1.5rem; float:right}
.modal-content img{width:100%; height:380px; object-fit:cover; border-radius:8px}
.modal-meta{padding-top:0.75rem}

/* Footer */
.site-footer{padding:1.25rem 0; border-top:1px solid rgba(255,255,255,0.03); margin-top:2rem}
.footer-inner{display:flex; justify-content:space-between; align-items:center}

/*about */
.about-photo {
   width: 400px;            /* Ukuran lingkaran */
  height: 400px;
    border-radius: 50%;      /* Membuat bentuk lingkaran */
    overflow: hidden;        /* Memotong bagian luar lingkaran */
    border: 2px solid #ccc;  /* Opsional: border mockup */
    box-shadow: 0 4px 8px rgba(0,0,0,0.1)
}


/* Responsive */
@media (max-width:980px){
  .hero-grid{grid-template-columns:1fr}
  .hero-card{order:2}
  .portfolio-grid{grid-template-columns:repeat(2,1fr)}
  .services-grid{grid-template-columns:repeat(2,1fr)}
  .contact-grid{grid-template-columns:1fr}
}
@media (max-width:600px){
  .nav{display:none}
  .nav-toggle{display:block}
  .portfolio-grid{grid-template-columns:1fr}
}
